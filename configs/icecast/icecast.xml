<icecast>
    <location>MusicBox</location>
    <admin>admin@musicbox.lan</admin>
    <limits>
        <clients>10</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
    </limits>
    <authentication>
        <source-password>musicbox-source</source-password>
        <relay-password>musicbox-relay</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>change-this-admin-password</admin-password>
    </authentication>
    <hostname>musicbox.lan</hostname>
    <listen-socket>
        <port>8000</port>
        <bind-address>127.0.0.1</bind-address>
    </listen-socket>
    <fileserve>1</fileserve>
    <paths>
        <logdir>/srv/musicbox/logs</logdir>
        <webroot>/usr/share/icecast/web</webroot>
        <adminroot>/usr/share/icecast/admin</adminroot>
    </paths>
    <logging>
        <accesslog>icecast-access.log</accesslog>
        <errorlog>icecast-error.log</errorlog>
        <loglevel>3</loglevel>
    </logging>
</icecast>
