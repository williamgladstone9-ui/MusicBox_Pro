#!/sbin/openrc-run
name="MusicBox Offline AP Address"
description="Assign static AP address for MusicBox offline mode"

start() {
    ebegin "Configuring wlan0 as MusicBox AP"
    ip link set wlan0 up || return 1
    ip addr flush dev wlan0 || true
    ip addr add 192.168.44.1/24 dev wlan0 || return 1
    eend $?
}
